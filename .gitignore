# Virtual environments
.venv/
venv/

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# Build and distribution artifacts
build/
dist/
*.egg-info/
*.whl
*.tar.gz
*.zip

# Environment files
.env
.env.local
*.env.*

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors and operating-system files
.vscode/
.idea/
*.swo
.DS_Store
Thumbs.db

# Fixtures are tracked test data: the global *.zip / *.log rules above would
# otherwise hide newly generated ones, and the tests need them to exist.
!fixtures/**/*.zip
!fixtures/**/*.log
