# --- Execution mode -------------------------------------------------------
# local (default): runs in-process, no Temporal/Postgres/Redis required.
# temporal: requires `docker compose up -d` + `python worker.py`.
NGS_MODE=local

# --- Temporal (only used when NGS_MODE=temporal or --temporal) ------------
TEMPORAL_HOST=localhost:7233

# --- Optional shared cache (Redis + MinIO). Omit to use the local
#     content-addressed filesystem cache at ~/.ngsagent/cache. --------------
REDIS_URL=redis://localhost:6379
CACHE_BUCKET=ngs-cache

# --- MinIO artifact storage (used by the agent containers) ----------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
ARTIFACT_BUCKET=ngs-artifacts

# --- LLM (optional; agents fall back to heuristics without a key) ---------
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
